pipeline {
    agent any

    tools {
        // IMPORTANT: This name must EXACTLY match the name in 
        // Manage Jenkins -> Tools -> SonarQube Scanner installations
        sonarScanner 'sonar-scanner' 
    }

    environment {
        APP_NAME        = "todo-app"
        IMAGE_NAME      = "todo-app:latest"
        SONAR_HOST_URL  = "http://192.168.0.88:9000"
        SONAR_PROJECT   = "todo-app"
    }

    stages {
        stage('Checkout Code') {
            steps {
                git branch: 'main', url: "https://github.com/RohanPatil198/CDAC_Project.git"
            }
        }

        stage('Build Docker Image') {
            steps {
                sh "docker build -t ${IMAGE_NAME} -f docker/Dockerfile ."
            }
        }

        stage('Trivy Image Scan') {
            steps {
                sh "trivy image --severity LOW,MEDIUM ${IMAGE_NAME}"
            }
        }

        stage('SonarQube Code Scan') {
            steps {
                // Using the scanner defined in the 'tools' block above
                sh "sonar-scanner -Dsonar.projectKey=${SONAR_PROJECT} -Dsonar.sources=app -Dsonar.host.url=${SONAR_HOST_URL}"
            }
        }
    }
}
