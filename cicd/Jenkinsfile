pipeline {
    agent any

    environment {
        APP_NAME        = "todo-app"
        IMAGE_NAME      = "todo-app:latest"
        SONAR_HOST_URL  = "http://192.168.0.137:9000"
        SONAR_PROJECT   = "todo-app"
        KUBECONFIG      = "/var/lib/jenkins/.kube/config"
    }

    stages {

        stage('Checkout Code') {
            steps {
                echo "Cloning source code..."
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                echo "Building Docker image..."
                sh '''
                  docker build -t ${IMAGE_NAME} -f docker/Dockerfile .
                '''
            }
        }

        stage('Trivy Image Scan') {
            steps {
                echo "Scanning Docker image with Trivy..."
                sh '''
                  trivy image --exit-code 0 --severity LOW,MEDIUM ${IMAGE_NAME}
                  trivy image --exit-code 1 --severity HIGH,CRITICAL ${IMAGE_NAME} || true
                '''
            }
        }

        stage('SonarQube Code Scan') {
            steps {
                echo "Running SonarQube analysis..."
                sh '''
                  sonar-scanner \
                    -Dsonar.projectKey=${SONAR_PROJECT} \
                    -Dsonar.sources=app \
                    -Dsonar.host.url=${SONAR_HOST_URL}
                '''
            }
        }

    }

}
